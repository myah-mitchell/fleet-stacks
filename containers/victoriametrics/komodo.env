#= Stack Specific Settings
#== Traefik
## Auth middleware chain for this stack's Traefik router. Leave blank for the
## real chain-authentik@file default (set in compose.yaml via
## ${TRAEFIK_AUTH_CHAIN:-chain-authentik@file}); override to chain-no-auth@file
## only for a bootstrap-phase deploy, before Authentik exists.
TRAEFIK_AUTH_CHAIN: 
#== VictoriaMetrics
VICTORIAMETRICS_HOSTNAME: victoriametrics
VICTORIAMETRICS_SERVICE_NAME: metrics
## The key a request must carry as authKey to delete series or reset the
## metric names statistics. Letters and digits only, since it travels in a URL.
VICTORIAMETRICS_ADMIN_AUTH_KEY: [[VICTORIAMETRICS_ADMIN_AUTH_KEY]]

#== VMAuth
VMAUTH_USER: [[GLOBAL_VMAUTH_USER]]
VMAUTH_PASS: [[GLOBAL_VMAUTH_PASS]]